# MirrorMind v2 Backend Configuration Example
APP_NAME="MirrorMind API"
APP_ENV="development"
API_PREFIX="/api"

# MongoDB Atlas URI (Vector Search & Collections)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=ZenLog"
MONGO_DB_NAME="mirrormind_db"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_NAME="gemini-3.8-flash"

# Cloudinary CDN Configuration
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
